{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["judgments"],
  "properties": {
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "system",
          "preserved_count",
          "compiled_requirement_count",
          "unsupported_count",
          "constraint_strength_ok",
          "correction_ok",
          "ambiguity_ok",
          "output_contract_ok",
          "notes"
        ],
        "properties": {
          "id": {"type": "string"},
          "system": {"type": "string", "enum": ["intent-rewrite-gate", "generic-rewrite"]},
          "preserved_count": {"type": "integer", "minimum": 0},
          "compiled_requirement_count": {"type": "integer", "minimum": 0},
          "unsupported_count": {"type": "integer", "minimum": 0},
          "constraint_strength_ok": {"type": "boolean"},
          "correction_ok": {"type": "boolean"},
          "ambiguity_ok": {"type": "boolean"},
          "output_contract_ok": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
